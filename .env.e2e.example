# Playwright E2E 계정 (이 파일을 복사해 .env.e2e 로 저장하세요 — 커밋 금지)
# cp .env.e2e.example .env.e2e

E2E_BASE_URL=http://127.0.0.1:8080

# 일반 근로자 — companies.type=contractor + role_new=worker 권장
# (ContractorGate 가 contractor/vendor 회사만 /settings 등을 차단함)
E2E_WORKER_EMAIL=
E2E_WORKER_PASSWORD=

# 협력사 소장 — type=contractor + site_manager(또는 작성 가능 역할)
E2E_CONTRACTOR_EMAIL=
E2E_CONTRACTOR_PASSWORD=

# 원청/발주 관리자 — project_admin | safety_manager | master
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
