# ── Client (Vite) ──
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_PROJECT_ID=
# VWorld WMTS (국토교통부) — Leaflet basemap. Restrict key by domain in VWorld console.
# VITE_VWORLD_API_KEY=

# ── All SafeNex AI via NVIDIA NIM (Nemotron Super by default) ──
# DeepSeek V4 Flash/Pro NIM endpoints deprecated 2026-08-07 → use one nvapi key.
# Set as Supabase Edge Function secrets (NOT Vite .env / Settings AI UI):
#   supabase secrets set NVIDIA_API_KEY=nvapi-...
# Optional: same key as legacy alias
#   supabase secrets set DEEPSEEK_API_KEY=nvapi-...
# Optional model override later (e.g. another NIM slug if risk AI is slow):
#   supabase secrets set RISK_AI_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# Risk scope_draft (초안) uses a FASTER chain by default (Mistral Small → Llama → Nemotron).
# Override draft primary or full chain if needed:
#   supabase secrets set RISK_AI_DRAFT_MODEL=mistralai/mistral-small-3.1-24b-instruct-2503
#   supabase secrets set RISK_AI_DRAFT_MODEL_CHAIN=mistralai/mistral-small-3.1-24b-instruct-2503,meta/llama-3.3-70b-instruct
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://integrate.api.nvidia.com/v1
RISK_AI_MODEL=
RISK_AI_DRAFT_MODEL=
RISK_AI_DRAFT_MODEL_CHAIN=
# Generation timeout (ms). Multi-row risk gen needs >> 3000; default in code is 90000.
DEEPSEEK_TIMEOUT_MS=90000

# ── Optional LAST-RESORT: OpenAI ChatGPT (risk AI only) ──
# Primary remains NVIDIA NIM. ChatGPT runs only when NIM fails or returns 0 items.
# Module lives in generate-risk-ai/openaiChat.ts (Dashboard-friendly path).
# Leave unset in normal ops. Set Edge secrets only when needed:
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set OPENAI_MODEL=gpt-4o-mini
#   supabase secrets set RISK_AI_OPENAI_FALLBACK=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_DRAFT_MODEL=
OPENAI_FILL_MODEL=
RISK_AI_OPENAI_FALLBACK=true
# openai = try ChatGPT first for scope_draft; nvidia = default (NIM first)
RISK_AI_DRAFT_PROVIDER=nvidia
OPENAI_TIMEOUT_MS=45000
