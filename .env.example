# ── Client (Vite) ──
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_PROJECT_ID=

# ── Risk assessment ONLY — DeepSeek V4 Flash via NVIDIA NIM ──
# Set these as Supabase Edge Function secrets (NOT in committed source):
#   supabase secrets set DEEPSEEK_API_KEY=nvapi-...
#   supabase secrets set DEEPSEEK_BASE_URL=https://integrate.api.nvidia.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://integrate.api.nvidia.com/v1
# Generation timeout (ms). Multi-row risk gen needs >> 3000; default in code is 90000.
DEEPSEEK_TIMEOUT_MS=90000

# ── Generic AI (accident / work-plan / other) — Nemotron via same NIM host ──
# NVIDIA_API_KEY=
