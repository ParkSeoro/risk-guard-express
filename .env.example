# Local Vite / tooling — copy to .env.local for own Supabase cutover.
# Do NOT commit real keys. Keep existing .env (Lovable) as backup.

VITE_SUPABASE_PROJECT_ID="your-new-project-ref"
VITE_SUPABASE_URL="https://your-new-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Optional (Edge / scripts only — never expose to the browser bundle)
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ACCESS_TOKEN=
