{
  "appId": "kr.safenex.desktop",
  "productName": "SafeNex PC",
  "electronVersion": "34.2.0",
  "directories": {
    "output": "release-desktop"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "release-desktop/safenex.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "SafeNex PC 안전관리 메신저",
    "runAfterFinish": true,
    "artifactName": "SafeNex_PC_Setup_${version}.${ext}"
  }
}
