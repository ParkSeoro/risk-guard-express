{$HLS_HOST} {
	encode gzip
	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods "GET, OPTIONS"
		Access-Control-Allow-Headers *
	}
	@options method OPTIONS
	respond @options 204
	handle /live/*/viewer-status {
		reverse_proxy viewer-gate:9197
	}
	handle {
		reverse_proxy mediamtx:8888
	}
}
